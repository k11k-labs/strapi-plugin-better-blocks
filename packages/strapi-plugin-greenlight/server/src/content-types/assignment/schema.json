{
  "kind": "collectionType",
  "collectionName": "greenlight_assignments",
  "info": {
    "singularName": "assignment",
    "pluralName": "assignments",
    "displayName": "Greenlight Assignment",
    "description": "Where one document, in one locale, currently sits in its workflow."
  },
  "options": {
    "draftAndPublish": false,
    "comment": "Managed by strapi-plugin-greenlight. Do not edit manually."
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    },
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "relatedDocumentId": {
      "type": "string",
      "required": true
    },
    "contentTypeUid": {
      "type": "string",
      "required": true
    },
    "locale": {
      "type": "string",
      "required": true,
      "default": ""
    },
    "stageId": {
      "type": "integer",
      "required": true
    },
    "assigneeId": {
      "type": "integer"
    },
    "version": {
      "type": "integer",
      "default": 0
    }
  }
}
