  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    },
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "relatedDocumentId": {
      "type": "string",
      "required": true
    },
    "contentTypeUid": {
      "type": "string",
      "required": true
    },
    "locale": {
      "type": "string",
      "required": true,
      "default": ""
    },
    "fromStageId": {
      "type": "integer"
    },
    "toStageId": {
      "type": "integer",
      "required": true
    },
    "fromStageName": {
      "type": "string"
    },
    "toStageName": {
      "type": "string",
      "required": true
    },
    "byUserId": {
      "type": "integer"
    },
    "byUserName": {
      "type": "string"
    },
    "comment": {
      "type": "text"
    }
  }
