# The Strapi plugin imports packages it does not declare (@dnd-kit/*, react-dnd,
# yup) because the Strapi admin panel provides them to plugins at runtime.
# Declaring them ourselves risks a second copy of react-dnd inside the admin
# bundle, which breaks drag & drop. pnpm's strict layout also gives
# @strapi/design-system a different @types/react than the plugin uses, and makes
# @strapi/types unnameable in emitted declarations (TS2742).
#
# A flat node_modules — the shape yarn v1 gave us — solves all three without
# touching any package's dependencies. node-linker is workspace-global in pnpm,
# so this necessarily applies to the renderers too.
node-linker=hoisted
