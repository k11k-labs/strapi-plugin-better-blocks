{
  "name": "@k11k/better-blocks-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Better Blocks — Strapi v5 blocks editor plugin and its React / Astro renderers",
  "license": "MIT",
  "author": "k11k-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k11k-labs/strapi-plugin-better-blocks.git"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "graph": "nx graph",
    "release:dry": "nx release --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "nx": "^23.1.1",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css,astro}": "prettier --write"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "packageManager": "pnpm@10.18.0"
}
